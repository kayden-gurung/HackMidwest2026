# Copy to frontend/.env (gitignored), then restart the frontend: docker compose restart frontend
# No secrets here: everything starting with VITE_ is visible in the browser.

# true (default): every feature uses mock data from features/*/api/mockData.ts.
# false: features call the backend through features/*/api/*Service.ts.
VITE_USE_MOCKS=true

# Prefix for API requests. Leave empty to use the Vite dev proxy (recommended).
VITE_API_BASE_URL=

# Where the Vite dev proxy sends /api. Docker default is http://backend:8000.
# Use http://localhost:8000 if you run `npm run dev` outside Docker.
# BACKEND_URL=http://backend:8000
