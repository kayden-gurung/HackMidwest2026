# Copy to backend/.env (gitignored) and fill in. Strands Agent() uses Amazon Bedrock by default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2
# Bedrock model/inference profile your account has been granted access to.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional. 0.0-1.0, default 0.3. Lower = more consistent, more literal answers.
# MODEL_TEMPERATURE=0.3
