# Copy to backend/.env (gitignored) and fill in. Strands Agent() uses Amazon Bedrock by default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2
# Bedrock model/inference profile your account has been granted access to.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional. 0.0-1.0, default 0.3. Lower = more consistent, more literal answers.
# MODEL_TEMPERATURE=0.3
# Optional. How many unpinned stops per plan to look up on the map (default 15, max 50).
# Each can add about a second to the reply.
# ROAM_MAX_PIN_LOOKUPS=15

# Route planner (docs/ROUTE_PLANNER.md). Demo routes planned in the background at startup, so they
# load instantly: "Start > Destination; Start > Destination". Leave it empty to turn warming off.
# ROAM_WARM_ROUTES=Kansas City, MO > Denver, CO; Kansas City, MO > St. Louis, MO; Kansas City, MO > Omaha, NE; Kansas City, MO > Wichita, KS
# Where saved map answers go (default backend/.roam_cache/http). Empty turns saving off.
# ROAM_HTTP_CACHE_DIR=
